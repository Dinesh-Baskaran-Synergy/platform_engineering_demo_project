# Copy to .env and fill in. NEVER commit .env (it is git-ignored).

# mock = offline deterministic fixtures (no key, no network); live = real calls via LiteLLM
EVAL_MODE=mock

# --- Option A: LiteLLM proxy / gateway (OpenAI-compatible) ---
# When set, these are passed as api_base / api_key on EVERY LiteLLM call.
LITELLM_API_BASE=
LITELLM_API_KEY=

# --- Model selection (LiteLLM model strings; never hardcoded in code) ---
# Proxy example:   APP_MODEL=openai/<your-proxy-alias>
# Direct example:  APP_MODEL=anthropic/<model-id>  (+ ANTHROPIC_API_KEY)
#                  APP_MODEL=openai/<model-id>     (+ OPENAI_API_KEY)
#                  APP_MODEL=bedrock/<model-id>    (+ AWS credentials)
APP_MODEL=
JUDGE_MODEL=
# Optional: defaults to APP_MODEL
EXTRACTOR_MODEL=
# Optional: used via LiteLLM `fallbacks` when the primary model call fails
FALLBACK_MODEL=

# --- Option B: direct provider keys (only if NOT using a proxy) ---
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# AWS_ACCESS_KEY_ID= / AWS_SECRET_ACCESS_KEY= / AWS_REGION_NAME=

# --- Optional tuning ---
# LLM_TIMEOUT_SECONDS=60
# LLM_NUM_RETRIES=3
# TOOL_CALLING=auto        # auto | native | prompt
# STRUCTURED_OUTPUT=auto   # auto | schema | prompt
